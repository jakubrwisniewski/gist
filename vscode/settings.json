{
  "css.format.spaceAroundSelectorSeparator": true,
  "debug.console.fontSize": 12,
  "debug.inlineValues": "on",
  "debug.openExplorerOnEnd": true,
  "debug.showBreakpointsInOverviewRuler": true,
  "debug.showSubSessionsInToolBar": true,
  "diffEditor.ignoreTrimWhitespace": true,
  "editor.bracketPairColorization.enabled": true,
  "editor.cursorBlinking": "phase",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.detectIndentation": false,
  "editor.fontSize": 12,
  "editor.guides.bracketPairs": true,
  "editor.inlayHints.enabled": "off",
  "editor.insertSpaces": false,
  "editor.linkedEditing": true,
  "editor.minimap.showSlider": "always",
  "editor.parameterHints.cycle": true,
  "editor.renderControlCharacters": false,
  "editor.renderLineHighlight": "all",
  "editor.rulers": [120],
  "editor.smoothScrolling": true,
  "editor.stickyScroll.enabled": true,
  "editor.suggest.preview": true,
  "editor.suggestSelection": "first",
  "emmet.showAbbreviationSuggestions": false,
  "emmet.showExpandedAbbreviation": "never",
  "explorer.autoReveal": false,
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.incrementalNaming": "smart",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.mergeEditor": true,
  "javascript.format.insertSpaceAfterFunctionKeywordForAnonymousFunctions": false,
  "javascript.format.insertSpaceAfterKeywordsInControlFlowStatements": false,
  "javascript.format.semicolons": "insert",
  "javascript.inlayHints.parameterNames.enabled": "all",
  "javascript.preferences.quoteStyle": "double",
  "problems.showCurrentInStatus": true,
  "scm.alwaysShowActions": true,
  "scss.format.spaceAroundSelectorSeparator": true,
  "search.showLineNumbers": true,
  "search.smartCase": true,
  "security.workspace.trust.untrustedFiles": "open",
  "settingsSync.ignoredExtensions": ["ginfuru.ginfuru-vscode-jekyll-syntax"],
  "terminal.integrated.cursorStyle": "line",
  "typescript.format.insertSpaceAfterFunctionKeywordForAnonymousFunctions": false,
  "typescript.format.insertSpaceAfterKeywordsInControlFlowStatements": false,
  "typescript.format.semicolons": "insert",
  "typescript.inlayHints.parameterNames.enabled": "all",
  "typescript.preferences.quoteStyle": "double",
  "typescript.updateImportsOnFileMove.enabled": "always",
  "window.title": "${rootName} • ${activeRepositoryBranchName}",
  "workbench.editor.closeOnFileDelete": true,
  "workbench.editor.decorations.badges": true,
  "workbench.editor.decorations.colors": true,
  "workbench.editor.highlightModifiedTabs": true,
  "workbench.startupEditor": "none",
  "workbench.tree.indent": 16,
  "workbench.view.alwaysShowHeaderActions": true,
  "emmet.includeLanguages": {
    "JavaScript": "javascriptreact",
  },
  "explorer.fileNesting.patterns": {
    "*.ts": "${capture}.js, ${capture}.test.ts",
    "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts, ${capture}.test.js",
    "*.jsx": "${capture}.js, ${capture}.test.jsx",
    "*.tsx": "${capture}.test.tsx, ${capture}.module.scss",
    "tsconfig.json": "tsconfig.*.json",
    "package.json": "package-lock.json, yarn.lock",
  },
  "createTestFile.languages": {
    "[typescript]": {
      "createTestFile.nameTemplate": "{filename}.test.ts",
    },
    "[javascript]": {
      "createTestFile.nameTemplate": "{filename}.test.js",
    },
    "[javascriptreact]": {
      "createTestFile.nameTemplate": "{filename}.test.jsx",
    },
    "[typescriptreact]": {
      "createTestFile.nameTemplate": "{filename}.test.tsx",
    },
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[scss]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "extensions.ignoreRecommendations": true,
  "editor.accessibilitySupport": "off",
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "window.dialogStyle": "custom",
  "workbench.editor.alwaysShowEditorActions": true,
  "search.exclude": {
    "**/build": true,
    "**/coverage": true,
  },
  "files.watcherExclude": {
    "**/coverage": true,
    "**/node_modules": true,
  },
  "diffEditor.renderSideBySide": true,
  "editor.inlineSuggest.suppressSuggestions": true,
  "explorer.compactFolders": false,
  "git.defaultBranchName": "master",
  "git.showPushSuccessNotification": true,
  "github.gitAuthentication": false,
  "git.terminalAuthentication": false,
  "eslint.useFlatConfig": true,
  "workbench.editor.enablePreview": false,
  "workbench.list.smoothScrolling": true,
  "terminal.integrated.smoothScrolling": true,
  "terminal.integrated.cursorBlinking": true,
  "chat.instructionsFilesLocations": {
    ".github/instructions": true,
    ".claude/rules": true,
  },
  "remoteHub.commitDirectlyWarning": "off",
  "workbench.iconTheme": "vscode-icons",
  "diffEditor.codeLens": true,
  "explorer.confirmPasteNative": false,
  "prettier.printWidth": 120,
  "prettier.requireConfig": true,
  "vsicons.dontShowNewVersionMessage": true,
  "eslint.run": "onSave",
  "mdb.mcp.server": "enabled",
  "errorLens.enabledDiagnosticLevels": ["warning", "info", "error"],
  "editor.formatOnSave": true,
  "files.eol": "\n",
  "biome.suggestInstallingGlobally": false,
  "terminal.integrated.enableMultiLinePasteWarning": "never",
  "vsicons.presets.foldersAllDefaultIcon": true,
  "http.systemCertificatesNode": true,
  "json.schemaDownload.trustedDomains": {
    "https://schemastore.azurewebsites.net/": true,
    "https://raw.githubusercontent.com/": true,
    "https://www.schemastore.org/": true,
    "https://json.schemastore.org/": true,
    "https://json-schema.org/": true,
    "https://biomejs.dev": true,
  },
  "workbench.activityBar.location": "top",
  "debug.toolBarLocation": "docked",
  "gitstash.advanced.debugEnabled": true,
  "window.menuBarVisibility": "compact",
  "editor.minimap.enabled": false,
  "window.commandCenter": false,
  "terminal.integrated.tabs.title": "${process}•",
  "editor.scrollbar.verticalScrollbarSize": 8,
  "editor.scrollbar.horizontalScrollbarSize": 8,
  "breadcrumbs.symbolPath": "last",
  "editor.scrollbar.horizontal": "hidden",
  "editor.wordWrap": "on",
  "chat.agent.maxRequests": 250,
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": false,
    "scminput": false,
  },
  "terminal.integrated.tabs.enabled": false,
  "chat.viewSessions.orientation": "stacked",
  "github.copilot.chat.languageContext.inline.typescript.enabled": true,
  "workbench.colorTheme": "Dark Modern",
  "workbench.statusBar.visible": false,
}
